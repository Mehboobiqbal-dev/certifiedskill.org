{
  "functions": {
    "pages/api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "pages/api/scrape.js": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{.next,*.cache,node_modules/{@mediapipe,puppeteer-*,face-api.js,pdfkit,canvas/build}/**,node_modules/**/*.{md,test.js,spec.js,d.ts,map}}"
    },
    "pages/api/puppeteer-scrape.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "pages/api/face-detection.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "pages/api/generate-pdf.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "pages/api/certificates/index.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "pages/api/certificate/generate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "pages/api/certificate/verify.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": {
        "Cache-Control": "s-maxage=0"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "images": {
    "sizes": [256, 512, 1024, 2048],
    "domains": ["certifiedskill.org"]
  }
}